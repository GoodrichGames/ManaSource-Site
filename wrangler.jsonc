{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mana-source-consent-region",
  "main": "cloudflare/consent-region-worker.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.manasourcegame.com/api/privacy-region",
      "zone_name": "manasourcegame.com"
    },
    {
      "pattern": "manasourcegame.com/api/privacy-region",
      "zone_name": "manasourcegame.com"
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      // Routes are inheritable, so without this the preview Worker would try to
      // claim the production hostnames on the manasourcegame.com zone.
      "routes": []
    }
  }
}
